{
  "name": "clicktopay-affiliation-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de declaration et d'affiliation des e-commercants a la plateforme ClickToPay",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:mcc": "node scripts/build-mcc-catalog.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
